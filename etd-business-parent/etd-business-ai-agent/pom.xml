<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.etd.framework.business</groupId>
        <artifactId>etd-business-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>etd-business-ai-agent</artifactId>
    <packaging>jar</packaging>
    <name>etd-business-ai-agent</name>
    <description>基于 Spring AI Alibaba 的智能体业务应用</description>

    <dependencyManagement>
        <dependencies>
            <!-- 复用框架统一的 Spring Boot、Spring AI 与 Alibaba BOM，业务模块不单独指定库版本。 -->
            <dependency>
                <groupId>org.etd.framework</groupId>
                <artifactId>etd-framework-dependencies</artifactId>
                <version>${etd.framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- 跨业务应用共享权限码等公共契约。 -->
        <dependency>
            <groupId>org.etd.framework.business</groupId>
            <artifactId>etd-business-common</artifactId>
        </dependency>
        <!-- AI 编排与模型 SDK 由框架 starter 统一提供，不装配依赖全局密钥的默认模型客户端。 -->
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-ai</artifactId>
        </dependency>

        <!-- 复用框架统一的数据访问、令牌鉴权和 Redis 登录状态校验能力。 -->
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-mybatis</artifactId>
            <exclusions>
                <!-- AI 服务直接使用 PostgreSQL，不加载未使用的分片能力和其他数据库驱动。 -->
                <exclusion>
                    <groupId>org.apache.shardingsphere</groupId>
                    <artifactId>shardingsphere-jdbc</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-security-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-cache</artifactId>
        </dependency>

        <!-- 资料上传复用框架MinIO客户端，不引入独立SDK版本。 -->
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-storage</artifactId>
        </dependency>

        <!-- 复用框架统一的 HTTP、时间序列化、日志能力。 -->
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.etd.framework</groupId>
            <artifactId>etd-framework-starter-logs</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 仅供离线启动测试验证连接池及 MyBatis 装配，正式运行只使用 PostgreSQL。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式启用MapStruct与Lombok编译期处理器，版本由共享BOM管理。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 父工程只管理插件版本，此处绑定 repackage 以生成可独立运行的业务应用。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
