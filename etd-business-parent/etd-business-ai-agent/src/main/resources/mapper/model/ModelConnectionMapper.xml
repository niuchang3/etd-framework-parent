<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.etd.ai.model.mapper.ModelConnectionMapper">
    <sql id="connectionWithModel">
        select c.*, m.model_name, m.model_type, m.provider_code, m.logo_path
        from ai_model_connection c
        join ai_model m on m.id = c.model_id
    </sql>

    <select id="selectConnectionPage" resultType="org.etd.ai.model.entity.ModelConnectionEntity">
        <include refid="connectionWithModel"/>
        where c.del_flag = 0
        <if test="modelId != null">
            and c.model_id = #{modelId}
        </if>
        <if test="dataStatus != null">
            and c.data_status = #{dataStatus}
        </if>
        <if test="providerCode != null">
            and m.provider_code = #{providerCode}
        </if>
        order by c.create_time desc, c.id desc
    </select>

    <select id="selectConnectionDetail" resultType="org.etd.ai.model.entity.ModelConnectionEntity">
        <include refid="connectionWithModel"/>
        where c.id = #{id}
          and c.del_flag = 0
    </select>

    <resultMap id="embeddingConnectionOption" type="org.etd.ai.model.mapper.result.EmbeddingConnectionOption">
        <id property="id" column="id"/>
        <result property="modelId" column="model_id"/>
        <result property="modelName" column="model_name"/>
        <result property="providerCode" column="provider_code"/>
        <result property="embedding" column="embedding" jdbcType="ARRAY"
                typeHandler="org.etd.ai.model.mapper.typehandler.EmbeddingDimensionsTypeHandler"/>
    </resultMap>

    <!-- 租户连接索引及模型主键支持关联；多表信息由SQL直接查询，服务层仅裁剪维度选项。 -->
    <select id="selectEmbeddingConnectionOptionList" resultMap="embeddingConnectionOption">
        select c.id,
               c.model_id,
               m.model_name,
               m.provider_code,
               m.embedding
        from ai_model_connection c
        join ai_model m on m.id = c.model_id
        where c.del_flag = 0
          and c.data_status = 1
          and m.del_flag = 0
          and m.data_status = 1
          and m.model_type = 'embedding'
        order by m.sort, m.id
    </select>
</mapper>
