<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.etd.ai.model.mapper.ModelConnectionMapper">
    <!-- model连接字段使用idx_ai_model_config_tenant_connection，知识库关联使用idx_ai_knowledge_base_model。 -->
    <select id="selectBoundKnowledgeBaseCount" resultType="java.lang.Long">
        select count(*)
        from ai_model_config m
        join ai_knowledge_base k on k.embedding_model_config_id = m.id
        where m.connection_id = #{id}
    </select>
</mapper>
