<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.etd.ai.model.mapper.ModelConfigMapper">
    <!-- 关联字段由idx_ai_knowledge_base_model覆盖，不在Java中循环关联。 -->
    <select id="selectKnowledgeBaseCount" resultType="java.lang.Long">
        select count(*)
        from ai_knowledge_base
        where embedding_model_config_id = #{id}
    </select>
</mapper>
