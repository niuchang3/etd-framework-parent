<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.etd.ai.knowledge.mapper.KnowledgeChunkMapper">
    <!-- 已在资料层校验访问范围；清理该资料的全部旧处理轮次。 -->
    <delete id="deleteDocumentChunks">
        delete from ai_knowledge_chunk
        where document_id = #{documentId}
    </delete>

    <!-- 固定维度逐表删除，复用当前事务，不使用动态表名或多语句执行。 -->
    <delete id="deleteDocumentVectors">
        delete from
        <choose>
            <when test="dimension == 768">ai_vector_768</when>
            <when test="dimension == 1024">ai_vector_1024</when>
            <otherwise>ai_vector_1536</otherwise>
        </choose>
        where document_id = #{documentId}
    </delete>
</mapper>
