<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.etd.upms.user.mapper.SystemUserMapper">

    <!-- 系统用户分页查询：数据归属以主组织为准，授权范围由框架通过 AND 追加 -->
    <select id="selectUserPage" resultType="org.etd.upms.user.entity.SystemUserEntity">
        SELECT
            u.id,
            u.create_time,
            u.create_by,
            u.update_time,
            u.update_by,
            u.data_status,
            u.del_flag,
            u.tenant_id,
            u.org_id,
            u.account,
            u.mobile,
            u.password,
            u.user_name,
            u.birthday,
            u.gender,
            u.avatar,
            u.nick_name,
            u.locked,
            u.enabled
        FROM sys_user u
        <where>
            u.del_flag = 0
            <if test="enabled != null">
                AND u.enabled = #{enabled}
            </if>
            <if test="locked != null">
                AND u.locked = #{locked}
            </if>
            <!-- null 表示未选节点；显式空范围必须拒绝匹配，不能退回全量查询。 -->
            <if test="orgIds != null">
                <choose>
                    <when test="orgIds.size() > 0">
                        AND u.org_id IN
                        <foreach collection="orgIds" item="orgId" open="(" separator="," close=")">
                            #{orgId}
                        </foreach>
                    </when>
                    <otherwise>
                        AND 1 = 0
                    </otherwise>
                </choose>
            </if>
            <if test="keyword != null and keyword != ''">
                AND (
                    u.account LIKE CONCAT('%', #{keyword}, '%')
                    OR u.user_name LIKE CONCAT('%', #{keyword}, '%')
                    OR u.mobile LIKE CONCAT('%', #{keyword}, '%')
                    OR u.nick_name LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
        ORDER BY u.create_time DESC, u.id DESC
    </select>

</mapper>
